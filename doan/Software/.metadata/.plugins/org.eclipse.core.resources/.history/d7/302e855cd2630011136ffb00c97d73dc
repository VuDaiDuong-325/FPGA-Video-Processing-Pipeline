#include "system.h"
#include "altera_avalon_pio_regs.h"
#include <stdio.h>

#define SDRAM_SRC_ADDR   ((volatile unsigned short *)0x00000000)
#define SDRAM_DST_ADDR   ((volatile unsigned short *)0x02000000)
#define IMAGE_SIZE_WORDS  307200

void copy_image(void) {
    volatile unsigned short *src = SDRAM_SRC_ADDR;
    volatile unsigned short *dst = SDRAM_DST_ADDR;

    printf("[SW] Copying image: 0x%08X -> 0x%08X (%d words)...\n",
           (unsigned int)src, (unsigned int)dst, IMAGE_SIZE_WORDS);

    for (int i = 0; i < IMAGE_SIZE_WORDS; i++) {
        dst[i] = src[i];
    }

    printf("[SW] Copy done.\n");
}

int main(void) {
    printf("=== DE1-SoC Image Display - Nios II ===\n");

    copy_image();

    IOWR_ALTERA_AVALON_PIO_DATA(PIO_IMG_LOAD_BASE, 0);
    IOWR_ALTERA_AVALON_PIO_DATA(PIO_IMG_LOAD_BASE, 1);

    printf("[SW] FPGA signaled. VGA display active.\n");

    while (1) { }
    return 0;
}
