module VGA_Controller (
    // Host Side
    input  [9:0]  iRed,
    input  [9:0]  iGreen,
    input  [9:0]  iBlue,
    output [10:0] oCurrent_X,
    output [10:0] oCurrent_Y,
    output [21:0] oAddress,
    output        oRequest,
    // VGA Side
    output [9:0]  oVGA_R,
    output [9:0]  oVGA_G,
    output [9:0]  oVGA_B,
    output reg    oVGA_HS,
    output reg    oVGA_VS,
    output        oVGA_SYNC,
    output reg    oVGA_BLANK,
    output        oVGA_CLOCK,
    // Control Signal
    input         iCLK,   // Phải cấp đúng 25.175 MHz hoặc 25 MHz từ PLL
    input         iRST_N
);

// Horizontal Timing Parameters (640x480 @ 60Hz)
parameter H_FRONT = 16;
parameter H_SYNC  = 96;
parameter H_BACK  = 48;
parameter H_ACT   = 640;
parameter H_BLANK = H_FRONT + H_SYNC + H_BACK;
parameter H_TOTAL = H_FRONT + H_SYNC + H_BACK + H_ACT; // 800

// Vertical Timing Parameters (Chuẩn hóa VESA)
parameter V_FRONT = 10;
parameter V_SYNC  = 2;
parameter V_BACK  = 33;
parameter V_ACT   = 480;
parameter V_BLANK = V_FRONT + V_SYNC + V_BACK;
parameter V_TOTAL = V_FRONT + V_SYNC + V_BACK + V_ACT; // 525

// Internal Registers
reg [10:0] H_Cont;
reg [10:0] V_Cont;

reg [10:0] VGA_X;
reg [10:0] VGA_Y;
reg [9:0]  VGA_R, VGA_G, VGA_B;

// Các thanh ghi tạo độ trễ (Pipeline Registers) để đồng bộ dữ liệu
reg c_HS, c_VS, c_BLANK;
reg r_HS, r_VS, r_BLANK;

// Giao tiếp cố định cho chip DAC ADV7123 trên kit Terasic
assign oVGA_SYNC  = 1'b0; 
assign oVGA_CLOCK = ~iCLK;

// Xuất dữ liệu trực tiếp từ các thanh ghi đã được đồng bộ hóa pha
assign oVGA_R = VGA_R;
assign oVGA_G = VGA_G;
assign oVGA_B = VGA_B;

// Đưa tọa độ và địa chỉ ra ngoài cho DMA/Memory Controller đọc trước
assign oCurrent_X = (H_Cont >= H_BLANK) ? (H_Cont - H_BLANK) : 11'd0;
assign oCurrent_Y = (V_Cont >= V_BLANK) ? (V_Cont - V_BLANK) : 11'd0;
assign oAddress   = oCurrent_Y * H_ACT + oCurrent_X;
assign oRequest   = ((H_Cont >= H_BLANK) && (V_Cont >= V_BLANK));

// Bộ đếm quét Ngang (Horizontal) và Dọc (Vertical) đồng bộ chung 1 Clock
always @(posedge iCLK or negedge iRST_N) begin
    if (!iRST_N) begin
        H_Cont <= 0;
        V_Cont <= 0;
    end else begin
        // Quét Ngang
        if (H_Cont < H_TOTAL - 1) begin
            H_Cont <= H_Cont + 1'b1;
        end else begin
            H_Cont <= 0;
            // Quét Dọc (Chỉ tăng khi kết thúc 1 dòng ngang)
            if (V_Cont < V_TOTAL - 1) begin
                V_Cont <= V_Cont + 1'b1;
            end else begin
                V_Cont <= 0;
            end
        end
    end
end

// Khối tạo tín hiệu điều khiển gốc (Tầng logic 0)
always @(*) begin
    c_HS    = ~((H_Cont >= H_FRONT) && (H_Cont < H_FRONT + H_SYNC));
    c_VS    = ~((V_Cont >= V_FRONT) && (V_Cont < V_FRONT + V_SYNC));
    c_BLANK =  ((H_Cont >= H_BLANK) && (V_Cont >= V_BLANK));
end

// Khối tạo tọa độ pixel hiển thị thực tế (Trễ 1 chu kỳ)
always @(posedge iCLK or negedge iRST_N) begin
    if (!iRST_N) begin
        VGA_X   <= 0;
        VGA_Y   <= 0;
        r_HS    <= 1;
        r_VS    <= 1;
        r_BLANK <= 0;
    end else begin
        VGA_X   <= oCurrent_X;
        VGA_Y   <= oCurrent_Y;
        r_HS    <= c_HS;
        r_VS    <= c_VS;
        r_BLANK <= c_BLANK;
    end
end

// Khối chọn màu xuất xưởng (Trễ 2 chu kỳ - Khớp hoàn toàn với r_HS/r_VS/r_BLANK dịch thêm tầng nữa)
always @(posedge iCLK or negedge iRST_N) begin
    if (!iRST_N) begin
        VGA_R      <= 0;
        VGA_G      <= 0;
        VGA_B      <= 0;
        oVGA_HS    <= 1;
        oVGA_VS    <= 1;
        oVGA_BLANK <= 0;
    end else begin
        // Đồng bộ các tín hiệu điều khiển sang tầng trễ thứ 2
        oVGA_HS    <= r_HS;
        oVGA_VS    <= r_VS;
        oVGA_BLANK <= r_BLANK;

        // Nếu nằm ngoài vùng hiển thị chủ động thì tắt màu hoàn toàn (Màu đen)
        if (!r_BLANK) begin
            VGA_R <= 10'd0;
            VGA_G <= 10'd0;
            VGA_B <= 10'd0;
        end else begin
            // Test Pattern: Vẽ hồng tâm/vạch chữ thập màu đỏ rực để test màn hình
            if ((VGA_X == 320) || (VGA_Y == 240) || (VGA_X == 180) || (VGA_Y == 120)) begin
                VGA_R <= 10'hFFF; // Đỏ max
                VGA_G <= 10'h000;
                VGA_B <= 10'h000;
            end else begin
                // Nếu không trúng vạch test thì xuất ảnh từ bộ xử lý ảnh/RAM
                VGA_R <= iRed;
                VGA_G <= iGreen;
                VGA_B <= iBlue;
            end
        end
    end
end

endmodule