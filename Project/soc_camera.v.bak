module soc_camera (
    // 1. Clock và Reset từ Board
    input  wire        CLOCK_50,  // Xung nhịp 50MHz trên mạch
    input  wire [0:0]  KEY,       // Nút nhấn KEY0 dùng làm Reset

    // 2. Các chân nối ra Camera OV7670 (GPIO)
    input  wire        CAM_PCLK,
    input  wire        CAM_VSYNC,
    input  wire        CAM_HREF,
    input  wire [7:0]  CAM_DIN,
    output wire [0:0]  LEDR,      // Dùng LED đỏ số 0 để báo FIFO Full

    // 3. Các chân nối ra chip SDRAM trên mạch (DRAM_...)
    output wire [12:0] DRAM_ADDR,
    output wire [1:0]  DRAM_BA,
    output wire        DRAM_CAS_N,
    output wire        DRAM_CKE,
    output wire        DRAM_CLK,
    output wire        DRAM_CS_N,
    inout  wire [15:0] DRAM_DQ,
    output wire [1:0]  DRAM_DQM,
    output wire        DRAM_RAS_N,
    output wire        DRAM_WE_N
);

    // =======================================================
    // Gọi (Instantiate) hệ thống Qsys vào đây
    // =======================================================
    system u0 (
        // Clock & Reset
        .clk_clk               (CLOCK_50), // Nối vào Clock 50MHz
        .reset_reset_n         (KEY[0]),   // Nối vào Nút nhấn KEY0

        // Camera Conduits (Tên cổng này phụ thuộc vào lúc bạn Export trong Qsys)
        .cam_pclk_export       (CAM_PCLK),
        .cam_vsync_export      (CAM_VSYNC),
        .cam_href_export       (CAM_HREF),
        .cam_din_export        (CAM_DIN),
        .fifo_full_warning_export (LEDR[0]),

        // SDRAM Conduits (Tên cổng do Qsys sinh ra, thường có tiền tố sdram_wire_)
        .sdram_wire_addr       (DRAM_ADDR),
        .sdram_wire_ba         (DRAM_BA),
        .sdram_wire_cas_n      (DRAM_CAS_N),
        .sdram_wire_cke        (DRAM_CKE),
        .sdram_wire_cs_n       (DRAM_CS_N),
        .sdram_wire_dq         (DRAM_DQ),
        .sdram_wire_dqm        (DRAM_DQM),
        .sdram_wire_ras_n      (DRAM_RAS_N),
        .sdram_wire_we_n       (DRAM_WE_N)
    );

    // Cấp clock cho chip SDRAM vật lý chạy (Tạm thời dùng chung Clock 50MHz)
    assign DRAM_CLK = CLOCK_50;

endmodule