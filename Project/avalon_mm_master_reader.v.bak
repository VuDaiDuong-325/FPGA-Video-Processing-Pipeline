// avalon_mm_master_reader.v
module avalon_mm_master_reader # (
    parameter ADDR_WIDTH = 32,
    parameter DATA_WIDTH = 16
)(
    input  wire                   clk_i,       // Clock hệ thống (50MHz)
    input  wire                   rst_i,       // Reset active high
    
    // Kết nối tới ghi DC_FIFO (Miền clock hệ thống)
    output reg                    fifo_we_o,
    output reg  [DATA_WIDTH-1:0]  fifo_din_o,
    input  wire                   fifo_full_i, 
    
    // Đồng bộ khung hình từ miền VGA (lấy từ tín hiệu VGA_VSYNC)
    input  wire                   vga_vsync_i, 
    
    // Giao tiếp Avalon-MM Master Read
    output reg  [ADDR_WIDTH-1:0]  amm_address_o,
    output reg                    amm_read_o,
    input  wire [DATA_WIDTH-1:0]  amm_readdata_i,
    input  wire                   amm_readdatavalid_i,
    input  wire                   amm_waitrequest_i
);

    localparam STATE_IDLE      = 2'd0;
    localparam STATE_WAIT_REQ  = 2'd1;
    localparam STATE_WAIT_DATA = 2'd2;

    reg [1:0] state_r;
    
    // Mạch bắt sườn đồng bộ vsync để reset địa chỉ đọc về đầu khung hình
    reg vga_vsync_d1, vga_vsync_d2;
    wire vsync_rising_edge = (vga_vsync_d1 == 1'b1 && vga_vsync_d2 == 1'b0);

    always @(posedge clk_i) begin
        if (rst_i) begin
            vga_vsync_d1 <= 1'b0;
            vga_vsync_d2 <= 1'b0;
        end else begin
            vga_vsync_d1 <= vga_vsync_i;
            vga_vsync_d2 <= vga_vsync_d1;
        end
    end

    // FSM Điều khiển đọc Bus Avalon Memory-Mapped
    always @(posedge clk_i) begin
        if (rst_i) begin
            amm_address_o <= {ADDR_WIDTH{1'b0}};
            amm_read_o    <= 1'b0;
            fifo_we_o     <= 1'b0;
            fifo_din_o    <= {DATA_WIDTH{1'b0}};
            state_r       <= STATE_IDLE;
        end else begin
            // Reset địa chỉ đọc về 0 khi bắt đầu một khung hình VGA mới
            if (vsync_rising_edge) begin
                amm_address_o <= {ADDR_WIDTH{1'b0}};
            end

            fifo_we_o <= 1'b0; // Mặc định tắt tín hiệu ghi FIFO

            case (state_r)
                STATE_IDLE: begin
                    // Nếu FIFO hiển thị chưa bị đầy, phát lệnh đọc dữ liệu kế tiếp từ SDRAM
                    if (!fifo_full_i) begin
                        amm_read_o <= 1'b1;
                        state_r    <= STATE_WAIT_REQ;
                    end
                end

                STATE_WAIT_REQ: begin
                    if (!amm_waitrequest_i) begin
                        amm_read_o <= 1'b0;
                        state_r    <= STATE_WAIT_DATA;
                    end
                end

                STATE_WAIT_DATA: begin
                    if (amm_readdatavalid_i) begin
                        fifo_we_o  <= 1'b1;
                        fifo_din_o <= amm_readdata_i;
                        
                        // Quản lý tăng địa chỉ tăng dần theo kích thước ảnh 640x480
                        if (amm_address_o < (640 * 480 - 1))
                            amm_address_o <= amm_address_o + 1'b1;
                        else
                            amm_address_o <= {ADDR_WIDTH{1'b0}};
                            
                        state_r <= STATE_IDLE;
                    end
                end
                default: state_r <= STATE_IDLE;
            endcase
        end
    end
endmodule