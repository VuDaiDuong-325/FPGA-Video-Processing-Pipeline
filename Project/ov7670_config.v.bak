module ov7670_config (
    input wire clk_i,         // Clock hệ thống 50MHz
    input wire rst_n_i,       // Reset từ nút bấm (Active-Low)
    output wire sioc_o,       // Kết nối tới chân SIOC vật lý của Camera
    inout wire siod_io,       // Kết nối tới chân SIOD vật lý của Camera
    output reg done_o         // Đèn LED báo hiệu nạp cấu hình thành công
);

    reg start_r;
    reg [7:0] reg_addr_r;
    reg [7:0] reg_data_r;
    wire ready_w;

    // Kết nối FSM Master vào mạch nội bộ
    sccb_master u_sccb (
        .clk_i      (clk_i),
        .rst_n_i    (rst_n_i),
        .start_i    (start_r),
        .reg_addr_i (reg_addr_r),
        .reg_data_i (reg_data_r),
        .ready_o    (ready_w),
        .sioc_o     (sioc_o),
        .siod_io    (siod_io)
    );

    // Số lượng thanh ghi cần nạp (Ở đây lấy ví dụ 7 thanh ghi cơ bản nhất)
    localparam TOTAL_REGS = 7;
    reg [7:0] rom_addr [0:TOTAL_REGS-1];
    reg [7:0] rom_data [0:TOTAL_REGS-1];
    
    initial begin
        // 1. Reset toàn bộ thanh ghi nội của camera về mặc định
        rom_addr[0] = 8'h12; rom_data[0] = 8'h80; 
        // 2. Cấu hình độ phân giải QVGA (320x240) và chọn định dạng Màu RGB
        rom_addr[1] = 8'h12; rom_data[1] = 8'h14; 
        // 3. Cấu hình cụ thể xuất định dạng màu RGB565 chính xác
        rom_addr[2] = 8'h40; rom_data[2] = 8'hd0; 
        // 4. Chia tần số Clock để PCLK hoạt động đồng bộ, mượt mà ổn định
        rom_addr[3] = 8'h11; rom_data[3] = 8'h01; 
        rom_addr[4] = 8'h0c; rom_data[4] = 8'h00; 
        rom_addr[5] = 8'h3e; rom_data[5] = 8'h00; 
        // 5. Thiết lập chiều phân cực đồng bộ cho chân VSYNC và chân PCLK
        rom_addr[6] = 8'h15; rom_data[6] = 16'h00; 
    end

    // Máy trạng thái nạp dữ liệu tuần tự
    localparam INIT_DELAY = 2'd0;
    localparam INIT_START = 2'd1;
    localparam INIT_WAIT  = 2'd2;
    localparam Selec_DONE = 2'd3;

    reg [1:0] state_r;
    reg [5:0] rom_idx_r;      // Chỉ số dòng ROM hiện tại đang đọc
    reg [23:0] delay_cnt_r;   // Đếm tạo độ trễ

    always @(posedge clk_i or megedge rst_n_i) begin
        if (!rst_n_i) begin
            state_r     <= INIT_DELAY;
            rom_idx_r   <= 0;
            start_r     <= 0;
            reg_addr_r  <= 0;
            reg_data_r  <= 0;
            done_o      <= 0;
            delay_cnt_r <= 0;
        end else begin
            case (state_r)
                // Phân đoạn 1: Đợi 15ms cho camera ổn định phần cứng khi mới cấp nguồn
                INIT_DELAY: begin
                    if (delay_cnt_r == 24'd750000) begin 
                        state_r <= INIT_START;
                    end else begin
                        delay_cnt_r <= delay_cnt_r + 1'b1;
                    end
                end

                // Phân đoạn 2: Lấy dữ liệu từ ROM nạp sang thanh ghi chuẩn bị truyền
                INIT_START: begin
                    if (rom_idx_r == TOTAL_REGS) begin
                        state_r <= Selec_DONE; // Đã cấu hình xong toàn bộ mảng
                    end else if (ready_w) begin
                        reg_addr_r <= rom_addr[rom_idx_r];
                        reg_data_r <= rom_data[rom_idx_r];
                        start_r    <= 1'b1; // Tạo xung kích hoạt sccb_master
                        state_r    <= INIT_WAIT;
                    end
                end

                // Phân đoạn 3: Chờ Bus Master truyền xong byte dữ liệu ra chân vật lý
                INIT_WAIT: begin
                    start_r <= 1'b0; // Hạ chân kích hoạt ngay lập tức
                    if (ready_w) begin
                        // Nếu vừa ghi xong thanh ghi Reset (Chỉ số 0), cần tạo thêm trễ nhỏ 1ms
                        if (rom_idx_r == 0) delay_cnt_r <= 0; 
                        
                        rom_idx_r <= rom_idx_r + 1'b1;
                        state_r   <= INIT_START;
                    end
                end

                // Phân đoạn 4: Hoàn tất, sáng LED thông báo
                Selec_DONE: begin
                    done_o  <= 1'b1;
                    start_r <= 1'b0;
                end
            endcase
        end
    end
endmodule